<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
        Icons in res/drawable are loaded dynamically via IconRegistry.getDrawableRes()
        using Resources.getIdentifier(). Lint can't detect this usage pattern, so it
        flags them as unused. These are false positives - the icons ARE used at runtime.
    -->
    <issue id="UnusedResources">
        <ignore path="**/res/drawable/ic_*.xml" />
        <ignore path="**/res/values/strings.xml" />
    </issue>

    <!--
        The app icon doesn't need a monochrome variant yet. This is optional and
        will be added in Phase 6 (Polish) if needed for themed icons.
    -->
    <issue id="MonochromeLauncherIcon" severity="informational" />

    <!--
        OldTargetApi warning about targetSdk 35: This is actually the latest stable
        Android version (Android 15). The warning appears to be a false positive from lint.
    -->
    <issue id="OldTargetApi" severity="informational" />
</lint>
